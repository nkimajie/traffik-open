# Copy to .env.development / .env.staging / .env.production and fill in real values.
# Config is loaded from .env.${NODE_ENV} — see src/config/configuration.ts.
# These files are gitignored; on AWS the values come from serverless.yml + GitHub Secrets.

# Server
PORT=4121

# JWT
JWT_SECRET=
JWT_EXPIRATION=7d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Apple Sign In
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_CALLBACK_URL=http://localhost:3000/auth/apple/callback

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# MongoDB
MONGODB_URI=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (Zoho Mail)
# SMTP_ENCRYPTION=tls pairs with port 587 (STARTTLS); use ssl with port 465.
# SMTP_FROM_EMAIL must equal SMTP_USER or Zoho refuses to relay.
# Zoho accounts with 2FA enabled require an application-specific password.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Traffik

# Public web app origin, used to build links inside emails
APP_WEB_URL=http://localhost:3000

# Optional: extra browser origins allowed to call the API directly (comma-separated).
# localhost:3000 is always allowed. The web app normally proxies through /api and
# does not need an entry here.
CORS_ALLOWED_ORIGINS=

# Kashia Vault escrow (https://vault.kashiahq.com/docs)
# Server-to-server only — never expose KASHIA_API_KEY in the frontend.
KASHIA_API_KEY=
KASHIA_WEBHOOK_SECRET=
KASHIA_BASE_URL=https://vault-api.kashiahq.com
